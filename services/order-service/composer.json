{
    "name": "u-badminton/order-service",
    "description": "Order Service",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "../../shared/common"
        }
    ],
    "require": {
        "php": "^8.2",
        "ddd-test/common": "*",
        "laravel/framework": "^11.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
